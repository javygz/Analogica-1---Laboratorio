void IRAM_ATTR TimerDisp(){
  temp++;
  if(temp > 2){
    temp = 0;
  }
}


void rgb(){

  if(temep < 23){
    digitalWrite(R, LOW);
    digitalWrite(G, LOW);
    digitalWrite(B, HIGH); //azul
  }
  else if((temep >= 23) && (temep < 25)){
    digitalWrite(R, LOW);
    digitalWrite(G, HIGH);
    digitalWrite(B, LOW); // Verde
  }
  else if((temep >= 25) && (temep < 27)){
    digitalWrite(R, HIGH);
    digitalWrite(G, HIGH);
    digitalWrite(B, LOW); // amarillo
  }
  else{
    digitalWrite(R, HIGH);
    digitalWrite(G, LOW);
    digitalWrite(B, LOW); // Rojo
  }

  switch(temp){
    case 0:
      digitalWrite(dis1, HIGH);
      digitalWrite(dis2, LOW);
      digitalWrite(dis3, LOW);
      digitalWrite(segdP, LOW);
      delay(5);
      break;
    case 1:
      digitalWrite(dis1, LOW);
      digitalWrite(dis2, HIGH);
      digitalWrite(dis3, LOW);
      digitalWrite(segdP, HIGH);
      delay(5);
      break;
    case 2:
      digitalWrite(dis1, LOW);
      digitalWrite(dis2, LOW);
      digitalWrite(dis3, HIGH);
      digitalWrite(segdP, LOW);
      delay(5);
      break;
  }
}

