/*Librerias*/ 
#include <Arduino.h>
#include <stdint.h>
#include <stdio.h>
#include <driver/gpio.h>

/*Variables globales*/
int contadorDecenas = 0;
int contadorBinarios = 0;
int velocidecenas = 1000;
int modo = 0;
int estadoateriorsuma = 0;
int estadoanteriorresta = 0;

const int led1 = 12;
const int led2 = 14;
const int led3 = 27;
const int led4 = 26;

const int botonsuma = 4;
const int botonresta = 5;
const int botonmodo = 22;

/*Declaración de variables*/
void setup() {
  pinMode(led1, OUTPUT);
  pinMode(led2, OUTPUT);
  pinMode(led3, OUTPUT);
  pinMode(led4, OUTPUT);

  pinMode(botonsuma, INPUT_PULLUP);
  pinMode(botonresta, INPUT);
  pinMode(botonmodo, INPUT);
}

/*Funciones adicionales*/
void mododec() {
  int essuma = digitalRead(botonsuma);
  int esresta = digitalRead(botonresta);
  contadorDecenas = 1;

  delay(15);
  if (essuma == HIGH){
    estadoateriorsuma = 1;
  }
  if (essuma == LOW && estadoateriorsuma == 1){
    contadorDecenas++;

    if (contadorDecenas >= 5){
      contadorDecenas = 0;
    }
    delay(15);
  }
  
  if (esresta == HIGH){
    estadoanteriorresta = 1;
  }
  if (esresta == LOW && estadoanteriorresta == 1){
    contadorDecenas--;

    if (contadorDecenas == 0){
      contadorDecenas = 4;

    }
    delay(15);
  }

  switch (contadorDecenas){
  case 1:
    digitalWrite(led1, HIGH);
    digitalWrite(led2, LOW);
    digitalWrite(led3, LOW);
    digitalWrite(led4, LOW);
    break;
  case 2:
    digitalWrite(led1, LOW);
    digitalWrite(led2, HIGH);
    digitalWrite(led3, LOW);
    digitalWrite(led4, LOW);
  case 3:
    digitalWrite(led1, LOW);
    digitalWrite(led2, LOW);
    digitalWrite(led3, HIGH);
    digitalWrite(led4, LOW);
    break;
  case 4:
    digitalWrite(led1, LOW);
    digitalWrite(led2, LOW);
    digitalWrite(led3, LOW);
    digitalWrite(led4, HIGH);
    break;
  }
  
}

