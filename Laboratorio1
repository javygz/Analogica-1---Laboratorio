/*Librerias*/ 
#include <Arduino.h>
#include <stdint.h>
#include <stdio.h>
#include <driver/gpio.h>

/*Variables globales*/
int contadorDecenas = 1;
int contadorBinarios = 1;
int modo = 0;
int estadoateriorsuma = 0;
int estadoanteriorresta = 0;
int estadoanteriormodo = 0;

const int led1 = 12;
const int led2 = 14;
const int led3 = 27;
const int led4 = 26;

const int botonsuma = 4;
const int botonresta = 18;
const int botonmodo = 22;

/*Declaración de variables*/
void setup() {
  pinMode(led1, OUTPUT);
  pinMode(led2, OUTPUT);
  pinMode(led3, OUTPUT);
  pinMode(led4, OUTPUT);

  pinMode(botonsuma, INPUT_PULLUP);
  pinMode(botonresta, INPUT);
  pinMode(botonmodo, INPUT);
}

/*Funciones adicionales*/

//función unicamente para el contador de las decenas
void mododec() {
  int essuma = digitalRead(botonsuma);
  int esresta = digitalRead(botonresta);

//antirebote para los dos botones en el circuito
  delay(15);
  if (essuma == LOW){
    estadoateriorsuma = 1;
  }
  if (essuma == HIGH && estadoateriorsuma == 1){
    contadorDecenas++;

    if (contadorDecenas == 5){
      contadorDecenas = 1;
    }
    estadoateriorsuma = 0;
    delay(15);

  }
  
  if (esresta == LOW){
    estadoanteriorresta = 1;
  }
  if (esresta == HIGH && estadoanteriorresta == 1){

    if (contadorDecenas == 0){
      contadorDecenas = 4;
    }
    else{
      contadorDecenas--;
    }
    estadoanteriorresta = 0;

    delay(15);
  }

//switch case con el contador de decenas
  switch (contadorDecenas){
  case 1:
    digitalWrite(led1, HIGH);
    digitalWrite(led2, LOW);
    digitalWrite(led3, LOW);
    digitalWrite(led4, LOW);
    break;
  case 2:
    digitalWrite(led1, LOW);
    digitalWrite(led2, HIGH);
    digitalWrite(led3, LOW);
    digitalWrite(led4, LOW);
    break;
  case 3:
    digitalWrite(led1, LOW);
    digitalWrite(led2, LOW);
    digitalWrite(led3, HIGH);
    digitalWrite(led4, LOW);
    break;
  case 4:
    digitalWrite(led1, LOW);
    digitalWrite(led2, LOW);
    digitalWrite(led3, LOW);
    digitalWrite(led4, HIGH);
    break;
  }
  
}

//función unicamente para el contador de binarios
void modobin(){
  int essuma = digitalRead(botonsuma);
  int esresta = digitalRead(botonresta);

//dos antirebote para los botones en el circuito
  delay(15);
  if (essuma == LOW){
    estadoateriorsuma = 1;
  }
  if (essuma == HIGH && estadoateriorsuma == 1){
    contadorBinarios++;

    if (contadorBinarios == 17){
      contadorBinarios = 1;
    }
    estadoateriorsuma = 0;
    delay(15);
  }
  
  if (esresta == LOW){
    estadoanteriorresta = 1;
  }
  if (esresta == HIGH && estadoanteriorresta == 1){
      
    if (contadorBinarios == 0){
      contadorBinarios = 16;
    }
    else{
      contadorBinarios--;
    }
    estadoanteriorresta = 0;
    delay(15);
  }
  
  //switch case con todos los números entre el 0-15
  switch (contadorBinarios){
  case 1:
    digitalWrite(led1, LOW);
    digitalWrite(led2, LOW);
    digitalWrite(led3, LOW);
    digitalWrite(led4, LOW);
    break;
  case 2:
    digitalWrite(led1, HIGH);
    digitalWrite(led2, LOW);
    digitalWrite(led3, LOW);
    digitalWrite(led4, LOW);
    break;
