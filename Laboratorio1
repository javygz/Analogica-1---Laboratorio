/*Función principal*/
void loop() {
  mododec();
  int essuma = digitalRead(botonsuma);
  int esresta = digitalRead(botonresta);
  modo = 0;

  delay(15);
  if (essuma == HIGH){
    estadoateriorsuma = 1;
  }
  if (essuma == LOW && estadoateriorsuma == 1){
    modo++;

    if (modo > 1){
      modo = 0;
    }
    delay(15);
  }
  
  if (esresta == HIGH){
    estadoanteriorresta = 1;
  }
  if (esresta == LOW && estadoanteriorresta == 1){
    modo--;

    if (modo < 0){
      modo = 1;
    }
    delay(15);
  }


 switch (modo) {
    case 0:
      contadorDecenas = 1;
      mododec();
      break;
    case 1:
      contadorBinarios = 1;
      modobin();
      break;
  }
}
