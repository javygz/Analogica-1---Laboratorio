/*Librerias*/ 
#include <Arduino.h>
#include <stdint.h>
#include <stdio.h>
#include <driver/gpio.h>
#define alarma 25000



/*Variables globales*/
int contadorBinarios = 1;
int contadorauto = 1;
int estadoateriorsuma = 0;
int estadoanteriorresta = 0;
int estadoled = LOW;

//estos primeros cuatro leds son para el contador binario
const int led1 = 4;
const int led2 = 18;
const int led3 = 19;
const int led4 = 21;

//estos ultimos cuatro leds son para el contador automatico
const int led5 = 13;

const int led6 = 33;
const int led7 = 25;
const int led8 = 26;
const int led9 = 27;

const int botonsuma = 22;
const int botonresta = 23;
const int boton3 = 32;

int comparador = LOW;

hw_timer_t *Timer0_Cfg = NULL;

void configTimer(void);
void IRAM_ATTR Timer0_ISR();
void IRAM_ATTR suma();
void IRAM_ATTR resta();


/*Declaración de variables*/
void setup() {
  pinMode(led1, OUTPUT);
  pinMode(led2, OUTPUT);
  pinMode(led3, OUTPUT);
  pinMode(led4, OUTPUT);

  pinMode(led5, OUTPUT);

  pinMode(led6, OUTPUT);
  pinMode(led7, OUTPUT);  
  pinMode(led8, OUTPUT);
  pinMode(led9, OUTPUT);

  attachInterrupt(botonsuma, &suma, RISING);
  attachInterrupt(botonresta, &resta, RISING);

  configTimer();
}


/*Funciones adicionales*/

//Apartado de timers y su configuración en el código
void IRAM_ATTR Timer0_ISR(){
  contadorauto++;
  if (contadorauto > 16){
    contadorauto = 1;
  }
}

//estos son las dos interrupciones que se activan al presionar los botones de suma y resta, incrementando o restando el contador binario
void IRAM_ATTR suma(){
  contadorBinarios++;
  if (contadorBinarios > 16){
    contadorBinarios = 1;
  }

}

void IRAM_ATTR resta(){
  contadorBinarios--;
  if (contadorBinarios < 1){
    contadorBinarios = 16;
  }

}

//es la función que reinicia el contador binario al presionar el cable tomado como botón
void cablecito(){
  if ((touchRead(boton3) < 30)){
    contadorauto = 0;
  }
}

void iguales(){
  if (contadorBinarios == contadorauto){
   
    estadoled = !estadoled;
    digitalWrite(led5, estadoled);
    contadorauto = 0;
   
  /*}
  else{
    comparador = LOW;
  }*/
}
}
void configTimer(void){
  Timer0_Cfg = timerBegin(0,800,true);

  timerAttachInterrupt(Timer0_Cfg, &Timer0_ISR, true);

  timerAlarmWrite(Timer0_Cfg, alarma, true);
  timerAlarmEnable(Timer0_Cfg);

}


